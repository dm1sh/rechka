    <!-- Benchmark screen -->
    <string name="benchmark_title">Тест производительности</string>
    <string name="benchmark_description">Прогоняет два тестовых ролика и показывает, во сколько раз быстрее реального времени работает распознавание на вашем устройстве. Результатом можно поделиться.</string>
    <string name="benchmark_run">Запустить тест</string>
    <string name="benchmark_results_title">Результат</string>
    <string name="benchmark_label_provider">Ускоритель</string>
    <string name="benchmark_label_time">Время</string>
    <string name="benchmark_label_rtf">RTF</string>
    <string name="benchmark_label_recognized">Что распознало</string>
    <string name="benchmark_share">Поделиться</string>
    <string name="benchmark_copy">Скопировать</string>
    <string name="benchmark_hero_label">скорость распознавания</string>
    <string name="benchmark_help_action">Как считается</string>
    <string name="benchmark_help_title">Как считается результат</string>
    <string name="benchmark_help_body">Речка работает в режиме голосового ввода: вы говорите, делаете паузу — и текст появляется. Пауза между вашей речью и появлением текста складывается из двух частей: время распознавания тишины (около полсекунды) плюс время обработки аудио моделью. Именно это второе время и измеряет тест.\n\nЧем больше число — тем быстрее телефон обрабатывает речь и тем короче ощущаемая пауза. При результате ×16 обработка занимает доли секунды — пока вы формулируете следующую мысль, текст уже напечатан. При ×4–5 пауза заметна: приходится ждать 1–2 секунды после каждой остановки.\n\nЧто означает ваш результат:\n×3–4 — пауза после речи заметна\n×5–9 — комфортно\n×10 и выше — почти мгновенно\n\nТест полезен, если хотите сравнить разные устройства или разобраться, почему на конкретном телефоне Речка работает медленнее.\n\nПервый запуск — медленнее: модель загружается с нуля. Повторный — реальная скорость в обычной работе. Длинный ролик (71 сек) проверяет, как устройство справляется с продолжительной записью.\n\nNNAPI — стандартный Android API для ускорения нейросетей. Какой именно чип он задействует (NPU, DSP или CPU) — решает сам Android в зависимости от устройства. Процессор — NNAPI недоступен, модель считает напрямую на CPU.\n\nТестовые ролики — официальные примеры GigaAM от Сбера, лицензия MIT:\nhttps://github.com/dm1sh/rechka/tree/main/app/src/main/assets</string>
    <string name="benchmark_help_close">Понятно</string>
    <string name="benchmark_short_title">Короткий ролик (11 сек)</string>
    <string name="benchmark_cold_title">Первый запуск</string>
    <string name="benchmark_warm_title">Повторный</string>
    <string name="benchmark_long_title">Длинный ролик (71 сек)</string>
    <string name="benchmark_long_run_label">Результат</string>
    <string name="benchmark_rating_good">Хороший результат</string>
    <string name="benchmark_rating_great">Отличный результат</string>
    <string name="benchmark_rating_excellent">Превосходный результат</string>
    <string name="benchmark_rtf_hint">×10 означает что 10 сек аудио обрабатывается за 1 сек. Чем больше число — тем быстрее устройство.</string>
