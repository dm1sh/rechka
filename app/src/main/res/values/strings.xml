    <!-- Onboarding: inline "try it" demo right after mic permission.
         Gives the user (and the модератор магазина приложений) an immediate reward:
         tap a button, say something, see the transcribed text. Proves the
         app is real before sending them into the more involved accessibility
         setup. Borrowed UX idea from Whisper Flow. -->
    <string name="onb_try_title">Попробуйте</string>
    <string name="onb_try_tap_to_start">Нажмите на микрофон и попробуйте набрать текст голосом</string>
    <string name="onb_try_tap_to_grant">Нажмите на микрофон и попробуйте набрать текст голосом</string>
    <!-- Sub-hint shown only at the moment the system mic-permission dialog is
         about to appear. Steers the user toward "При использовании
         приложения" — picking "Только в этот раз" causes Android to silently
         revoke the permission later and kill our process, leaving users
         confused about why the bubble stopped working. -->
    <string name="onb_try_grant_hint">Выберите «При использовании приложения»</string>
    <string name="onb_try_denied">Доступ к микрофону закрыт</string>
    <string name="onb_try_open_settings">Открыть настройки</string>
    <string name="onb_try_tap_to_stop">Говорите…</string>
    <string name="onb_try_done">Отлично! У Вас получилось! Нажмите «Далее» для продолжения настройки</string>
    <string name="onb_try_preparing">Готовим распознавание…</string>
    <string name="onb_try_result_placeholder">Здесь появится текст</string>

